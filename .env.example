# ===========================================
# BlueReach SAAS - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Service (Required for sending invitation emails)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxx

# App URL (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Required for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  # Only needed if using Stripe.js client-side

# ===========================================
# OPTIONAL - API keys stored in database
# ===========================================
# These keys are typically configured via the Settings UI
# and stored securely in the Supabase database.
# Only set these if you need environment variable fallback.

# Instantly API Key (optional - configure via Settings UI)
# INSTANTLY_API_KEY=

# Instantly Webhook Secret (optional - configure via Settings UI)
# INSTANTLY_WEBHOOK_SECRET=

# Smartlead API Key (optional - configure via Settings UI)
# SMARTLEAD_API_KEY=
